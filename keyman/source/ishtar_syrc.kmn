store(&VERSION) '14.0'
store(&NAME) 'Ishtar Syriac — Ramsina layout'
store(&KEYBOARDVERSION) '0.1.0'
store(&TARGETS) 'any'
store(&LAYOUTFILE) 'ishtar_syrc.keyman-touch-layout'
